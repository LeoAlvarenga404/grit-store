<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name grit-api</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Published only (not copied to bin): the compose image seeds from /app/seed/catalog.json (AppHost Seed__Path). -->
    <Content Include="../../seed/catalog.json" Link="seed/catalog.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grit.BuildingBlocks\Grit.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Grit.Modules.Basket\Grit.Modules.Basket.csproj" />
    <ProjectReference Include="..\Grit.Modules.Catalog\Grit.Modules.Catalog.csproj" />
    <ProjectReference Include="..\Grit.Modules.Identity\Grit.Modules.Identity.csproj" />
    <ProjectReference Include="..\Grit.Modules.Inventory\Grit.Modules.Inventory.csproj" />
    <ProjectReference Include="..\Grit.Modules.Ordering\Grit.Modules.Ordering.csproj" />
    <ProjectReference Include="..\Grit.Modules.Payments\Grit.Modules.Payments.csproj" />
    <ProjectReference Include="..\Grit.ServiceDefaults\Grit.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
